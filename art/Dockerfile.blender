# Blender as a Python module, for rendering the animated unit sprite sheets (`make art-units`).
# Cycles on the CPU: no display and no GPU needed. About 2.7 GB.
FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      libxrender1 libxxf86vm1 libxfixes3 libxi6 libxkbcommon0 libsm6 libice6 libgl1 libegl1 libgomp1 \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir bpy==4.2.0 pillow==11.0.0
WORKDIR /src

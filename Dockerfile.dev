# Dev image: Go toolchain, the Node binary, and every Go module already downloaded.
# Rebuild only when go.mod or go.sum changes (make image). Nothing is installed at run time,
# and the test target runs with the network off to prove it.
FROM node:24-slim AS node

FROM golang:1.27.4-trixie
COPY --from=node /usr/local/bin/node /usr/local/bin/node
ENV GOMODCACHE=/go/pkg/mod \
    GOCACHE=/gocache \
    GOFLAGS=-mod=readonly \
    GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download \
 && mkdir -p /gocache \
 && chmod -R a+rwX /go/pkg/mod /gocache \
 && node --version

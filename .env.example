# "1" only on your own machine. The keys below marked "yours" are used only then; a public
# server leaves them empty and this unset, and holds only its players' own keys.
CALLSIGN_PRIVATE=
# Anthropic API key (sk-ant-api...). Squads think with the Claude API.
CALLSIGN_ANTHROPIC_KEY=
# Or, for testing: a Claude subscription token from `claude setup-token` (sk-ant-oat...).
# Squads then think through Claude Code, slower and against the subscription's limits.
CALLSIGN_CLAUDE_TOKEN=

# Model relay (relay/). Both are optional on one machine.
# 32 random bytes in hex or base64 that seal the stored AI keys, for example from
# `openssl rand -hex 32`. Left empty, the relay makes .relay-data/master.key itself.
CALLSIGN_RELAY_MASTER_KEY=
# The secret the game server's own services show it: the agent host and the model relay.
# `make play` makes a fresh one for every run; set it here only when you start the parts
# by hand. With it set, commanders need seat tokens and the open room of Phase 0 is gone.
CALLSIGN_AGENT_KEY=

# The game's own TypeSafe key (console.typesafe.ai/keys) for the squads' fast brain, Jev.
# Only the relay reads it; it is never sent to a browser. Left empty, the fast brain is off
# and squads without a player's key use the rule brain, which needs no AI at all.
CALLSIGN_JEV_KEY=
# The most the fast brain may spend on that key in one day (UTC), in dollars. Past it,
# squads quietly use the rule brain until the next day. A decision costs about 0.007 cents.
CALLSIGN_JEV_DAILY_USD=2
# true: matches use the fast brain unless their maker turns it off in the lobby.
CALLSIGN_FAST_BRAIN=false
# The rule-brain Anvil's initiative when a match sets none: 1 orders only, 2 also the
# economy when it holds the purse, 3 also the fight when handed it.
CALLSIGN_ANVIL_LEVEL=3

# make play-public: https for a friend anywhere, through a Cloudflare Tunnel on your domain.
# The address the tunnel's public hostname serves, and the tunnel's token.
CALLSIGN_PUBLIC_URL=
CALLSIGN_TUNNEL_TOKEN=
# Password for making matches on the public address. Left empty, one is made on each run.
CALLSIGN_HOST_KEY=

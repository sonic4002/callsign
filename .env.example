# Anthropic API key (sk-ant-api...). Squads think with the Claude API.
CALLSIGN_ANTHROPIC_KEY=
# Or, for testing: a Claude subscription token from `claude setup-token` (sk-ant-oat...).
# Squads then think through Claude Code, slower and against the subscription's limits.
CALLSIGN_CLAUDE_TOKEN=

# Model relay (relay/). Both are optional on one machine.
# 32 random bytes in hex or base64 that seal the stored AI keys, for example from
# `openssl rand -hex 32`. Left empty, the relay makes .relay-data/master.key itself.
CALLSIGN_RELAY_MASTER_KEY=
# A secret the relay sends the game server with every tier question, so that only the
# relay can ask. Set the same value on both when they do not share a private network.
CALLSIGN_INTERNAL_SECRET=

#!/bin/sh
# Vault notes are checked against vault/00-Meta/Conventions.md before they are committed.
# Enable once per clone:  git config core.hooksPath .githooks
if git diff --cached --name-only | grep -q '^vault/'; then
  root=$(git rev-parse --show-toplevel)
  python3 "$root/vault/_tools/validate_frontmatter.py" --all >/dev/null || exit 1
  python3 "$root/vault/_tools/gen_index.py" --check || exit 1
fi
exit 0
